#! /usr/bin/env zsh

yabai -m config layout bsp
yabai -m config split_type auto
yabai -m config auto_balance off
yabai -m config top_padding 0
yabai -m config bottom_padding 0
yabai -m config right_padding 0
yabai -m config left_padding 0
yabai -m config window_gap 4
yabai -m config mouse_follows_focus on
yabai -m config window_placement second_child
yabai -m config mouse_modifier fn

# exclude Chrome Picture in Picture windows
yabai -m rule --add title="^(Picture in Picture|Picture-in-Picture)$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Rancher Desktop" manage=off
yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^FaceTime$" manage=off
yabai -m rule --add app="^Photo Booth$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add title='^Slack \| mini panel$' manage=off
yabai -m rule --add subrole="^AXSystemDialog$" manage=off mouse_follows_focus=off

# JetBrains main windows get their project title after creation, so the
# title-change signal promotes them once it matches (scripts/jetbrains_promote.sh)
apps='^(GoLand|DataGrip)$'
main_title='\[.*\] – '
yabai -m rule --add app="${apps}" manage=off
yabai -m rule --add label=jetbrains-manage app="${apps}" title="${main_title}" manage=on
yabai -m signal --add label=jetbrains-created event=window_created app="${apps}" \
  action='sh $HOME/.config/yabai/scripts/jetbrains_promote.sh track'
yabai -m signal --add label=jetbrains-title event=window_title_changed app="${apps}" \
  title="${main_title}" \
  action='sh $HOME/.config/yabai/scripts/jetbrains_promote.sh promote'
